{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "description": "Cross-compile for TDX ARMv8a using the Yocto SDK",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/linux/build",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}